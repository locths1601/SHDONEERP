<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ShdOneErp.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShdOneErp.Domain\ShdOneErp.Domain.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\ShdOneErp.Application\ShdOneErp.Application.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\ShdOneErp.Infrastructure\ShdOneErp.Infrastructure.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\ShdOneErp.Api\ShdOneErp.Api.csproj" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

</Project>
